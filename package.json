{
  "name": "sanding-monitoring-web-app",
  "version": "1.20.0",
  "description": "A basic React app with minimal dependencies",
  "type": "module",
  "bin": {
    "sanding-history": "dist-sanding-history/sanding-history.mjs"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run build && npx serve -s dist",
    "build": "vite build",
    "build:sanding-history": "esbuild sanding-history/index.ts --bundle --platform=node --format=esm --target=node22 --packages=bundle --banner:js='#!/usr/bin/env node' --outfile=dist-sanding-history/sanding-history.mjs && chmod +x dist-sanding-history/sanding-history.mjs",
    "sanding-history": "node dist-sanding-history/sanding-history.mjs",
    "preview": "vite preview",
    "sanity": "npm run typecheck && npm run typecheck:sanding-history && npm run lint",
    "typecheck": "tsc --noEmit",
    "typecheck:sanding-history": "tsc -p sanding-history/tsconfig.json",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"sanding-history/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"sanding-history/**/*.{js,ts}\" --fix",
    "test": "vitest",
    "view-bundle": "ANALYZE_DEBUG=true npm run build",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@ag-grid-community/client-side-row-model": "^32.3.9",
    "@ag-grid-community/core": "^32.3.9",
    "@ag-grid-community/styles": "^32.3.9",
    "@tanstack/svelte-query": "^5.69.0",
    "@threlte/core": "^8.5.16",
    "@threlte/extras": "^9.20.1",
    "@viamrobotics/motion-tools": "1.22.0",
    "@viamrobotics/prime-core": "0.1.5",
    "@viamrobotics/sdk": "^0.57.0",
    "@viamrobotics/svelte-sdk": "^1.0.1",
    "js-cookie": "^3.0.5",
    "koota": "^0.6.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.10.1",
    "runed": "^0.37.1",
    "three": "0.183.2",
    "vitest": "^4.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.0",
    "prettier": "^3.7.4",
    "svelte": "^5.46.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.1.13",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vite-bundle-analyzer": "^1.3.2",
    "vite-plugin-glsl": "^1.6.0"
  }
}
